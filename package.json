{
  "name": "place",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=24.5.0 <25"
  },
  "packageManager": "npm@11.14.1",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "nx": "nx",
    "dev": "nx run-many -t dev --projects=tiling-images,place-nft --parallel=2",
    "dev:tiling-images": "nx dev tiling-images",
    "dev:place-nft": "nx dev place-nft",
    "build": "nx run-many -t build",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "typecheck": "nx run-many -t typecheck"
  },
  "devDependencies": {
    "@nx/next": "^23.1.0",
    "@nx/vite": "^23.1.0",
    "nx": "^23.1.0"
  }
}
