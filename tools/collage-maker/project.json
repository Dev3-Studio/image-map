{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "collage-maker",
  "projectType": "application",
  "sourceRoot": "tools/collage-maker/src",
  "tags": [
    "type:tool",
    "scope:rust"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/target"
      ],
      "options": {
        "command": "cargo build --locked",
        "cwd": "tools/collage-maker"
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "cache": true,
      "outputs": [
        "{projectRoot}/target"
      ],
      "options": {
        "command": "cargo check --locked",
        "cwd": "tools/collage-maker"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/target"
      ],
      "options": {
        "command": "cargo clippy --locked --all-targets",
        "cwd": "tools/collage-maker"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/target"
      ],
      "options": {
        "command": "cargo test --locked",
        "cwd": "tools/collage-maker"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "cargo fmt --check",
        "cwd": "tools/collage-maker"
      }
    },
    "run": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo run --locked",
        "cwd": "tools/collage-maker"
      }
    },
    "publish-showcase": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/apps/place-nft/public/iiif"
      ],
      "options": {
        "command": "cargo run --locked -- publish-grid --images showcase --output ../../apps/place-nft/public/iiif --base-url /iiif --canvas-width 768 --columns 3 --tile-size 1024 --jpeg-quality 82 --preview-output ../../apps/place-nft/public/collage.webp --coords-output ../../apps/place-nft/src/assets/coords.json",
        "cwd": "tools/collage-maker"
      }
    }
  }
}
