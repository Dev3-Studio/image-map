{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "collage-maker",
  "projectType": "application",
  "sourceRoot": "tools/collage-maker/src",
  "tags": [
    "type:tool",
    "scope:rust"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/target"
      ],
      "options": {
        "command": "cargo build --locked",
        "cwd": "tools/collage-maker"
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "cache": true,
      "outputs": [
        "{projectRoot}/target"
      ],
      "options": {
        "command": "cargo check --locked",
        "cwd": "tools/collage-maker"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/target"
      ],
      "options": {
        "command": "cargo clippy --locked --all-targets",
        "cwd": "tools/collage-maker"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/target"
      ],
      "options": {
        "command": "cargo test --locked",
        "cwd": "tools/collage-maker"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "cargo fmt --check",
        "cwd": "tools/collage-maker"
      }
    },
    "run": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo run --locked",
        "cwd": "tools/collage-maker"
      }
    },
    "publish-showcase": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/apps/place-nft/public/iiif"
      ],
      "options": {
        "command": "cargo run --locked -- publish-grid --images showcase --output ../../apps/place-nft/public/iiif --base-url /iiif --canvas-width 768 --columns 3 --tile-size 1024 --jpeg-quality 82 --preview-output ../../apps/place-nft/public/collage.webp --coords-output ../../apps/place-nft/src/assets/coords.json",
        "cwd": "tools/collage-maker"
      }
    },
    "publish-stress": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/output/r2-demo"
      ],
      "options": {
        "command": "cargo run --release --locked -- publish-stress --images ../../Images --coords ../../apps/place-nft/public/coords4999.json --output output/r2-demo/iiif --preview-output output/r2-demo/collage.webp --preview-size 2048 --medium-preview-output output/r2-demo/collage-medium.webp --medium-preview-size 6400 --base-url https://pub-78666f1dd7984ef69f57781fac523d68.r2.dev/tessera-5000-v1/iiif --canvas-width 12800 --coordinate-divisor 2",
        "cwd": "tools/collage-maker"
      }
    }
  }
}
