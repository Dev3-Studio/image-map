FROM rust:1.94.1-alpine AS builder

RUN apk add --no-cache clang-dev cmake g++ make musl-dev nasm perl
WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY src ./src
RUN cargo build --release --locked --features lambda --bin collage-lambda

FROM public.ecr.aws/lambda/provided:al2023
COPY --from=builder /build/target/release/collage-lambda /var/runtime/bootstrap
ENTRYPOINT ["/var/runtime/bootstrap"]
